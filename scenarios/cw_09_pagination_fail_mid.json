{
  "name": "cw_09_pagination_fail_mid",
  "description": "GĐ3 - Trang 1 OK (2 event) nhưng trang 2 bị Throttling: trang 1 ĐÃ vào Kafka, last_query không tiến -> chu kỳ sau kéo lại trang 1 (TRÙNG cw-dup-p1-1/2)",
  "rules": [
    {
      "id": "cw_09_pagination_fail_mid_1",
      "name": "[CW] Trang 2 - Throttling",
      "enabled": true,
      "mode": "all",
      "match": {
        "method": "POST",
        "headers": {
          "X-Amz-Target": "Logs_20140328.FilterLogEvents"
        },
        "body_regex": "\"nextToken\"\\s*:\\s*\"cw-dup-page-2\""
      },
      "response": {
        "status": 400,
        "headers": {
          "Content-Type": "application/x-amz-json-1.1",
          "x-amzn-ErrorType": "ThrottlingException"
        },
        "body": {
          "__type": "ThrottlingException",
          "message": "Rate exceeded"
        }
      }
    },
    {
      "id": "cw_09_pagination_fail_mid_2",
      "name": "[CW] Trang 1 - OK",
      "enabled": true,
      "mode": "all",
      "match": {
        "method": "POST",
        "headers": {
          "X-Amz-Target": "Logs_20140328.FilterLogEvents"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/x-amz-json-1.1"
        },
        "body": {
          "events": [
            {
              "eventId": "cw-dup-p1-1",
              "logStreamName": "mock-stream-01",
              "timestamp": "{{PAST_MS:9}}",
              "message": "{\"log_type\":\"cloudtrail\",\"event_id\":\"cw-dup-p1-1\",\"user\":\"iam-admin\",\"action\":\"CreateSecurityGroup\",\"ip\":\"54.23.11.2\",\"time\":\"{{NOW_ISO}}\"}",
              "ingestionTime": "{{NOW_MS}}"
            },
            {
              "eventId": "cw-dup-p1-2",
              "logStreamName": "mock-stream-01",
              "timestamp": "{{PAST_MS:8}}",
              "message": "{\"log_type\":\"cloudtrail\",\"event_id\":\"cw-dup-p1-2\",\"user\":\"iam-admin\",\"action\":\"CreateSecurityGroup\",\"ip\":\"54.23.11.2\",\"time\":\"{{NOW_ISO}}\"}",
              "ingestionTime": "{{NOW_MS}}"
            }
          ],
          "searchedLogStreams": [
            {
              "logStreamName": "mock-stream-01",
              "searchedCompletely": false
            }
          ],
          "nextToken": "cw-dup-page-2"
        }
      }
    }
  ]
}