{
  "name": "m365_pagination_nextpageuri",
  "description": "M365 - Ph\u00e2n trang 2 trang b\u1eb1ng header NextPageUri",
  "rules": [
    {
      "id": "rule_m365_content_blobs",
      "match": {
        "method": "GET",
        "path": "/subscriptions/content",
        "path_match": "contains"
      },
      "response": {
        "sequence": [
          {
            "status": 200,
            "headers": {
              "Content-Type": "application/json",
              "NextPageUri": "https://manage.office.com/api/v1.0/tenant/activity/feed/subscriptions/content?nextPage=page_2"
            },
            "body_type": "fixture",
            "fixture": "m365_page1.json"
          },
          {
            "status": 200,
            "headers": {
              "Content-Type": "application/json"
            },
            "body_type": "fixture",
            "fixture": "m365_page2.json"
          }
        ]
      }
    }
  ]
}