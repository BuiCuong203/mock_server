{
  "name": "azure_proxy_504",
  "description": "azure - L\u1ed7i 504 Gateway Timeout",
  "rules": [
    {
      "id": "rule_azure_signin_logs_proxy",
      "name": "Override: 504 Gateway Timeout",
      "enabled": true,
      "match": {
        "method": "GET",
        "path": "/auditLogs/",
        "path_match": "contains"
      },
      "response": {
        "delay_ms": 15000,
        "status": 504,
        "headers": {
          "Content-Type": "text/html",
          "Server": "Squid/4.10"
        },
        "body": "<html><head><title>504 Gateway Time-out</title></head><body><center><h1>504 Gateway Time-out</h1></center><hr><center>Squid/4.10</center></body></html>"
      }
    }
  ]
}