{
  "name": "defender_oauth_error_401",
  "description": "Defender - Lỗi 401 khi XIN cấp Token (OAuth Server từ chối)",
  "rules": [
    {
      "id": "rule_defender_token",
      "name": "Override: Defender Direct Token Error",
      "enabled": true,
      "match": {
        "method": "POST",
        "path": "/mock/defender/token",
        "path_match": "prefix"
      },
      "response": {
        "status": 401,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "error": "invalid_client",
          "error_description": "AADSTS7000215: Invalid client secret is provided for Defender."
        }
      }
    },
    {
      "id": "rule_defender_token_proxy",
      "name": "Override: Defender Proxy Token Error",
      "enabled": true,
      "match": {
        "method": "POST",
        "host": "*.microsoftonline.com",
        "path": "/oauth2/",
        "path_match": "contains"
      },
      "response": {
        "status": 401,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "error": "invalid_client",
          "error_description": "AADSTS7000215: Invalid client secret is provided for Defender Proxy."
        }
      }
    }
  ]
}
