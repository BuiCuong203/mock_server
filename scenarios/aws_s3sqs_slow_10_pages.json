{
  "name": "aws_s3sqs_slow_10_pages",
  "description": "aws_s3sqs - Ch\u1eadm 3s trong 10 trang \u0111\u1ea7u",
  "rules": [
    {
      "id": "rule_aws_s3_get_object",
      "name": "Override: aws_s3sqs Slow 10 Pages",
      "enabled": true,
