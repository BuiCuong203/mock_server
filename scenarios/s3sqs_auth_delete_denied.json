{
  "name": "s3sqs_auth_delete_denied",
  "description": "Auth fail - thiếu quyền sqs:DeleteMessage: log ĐÃ được đẩy nhưng xóa message 403 AccessDenied -> Failed SQS message (may be reprocessed); AWS thật sẽ gửi lại message -> trùng log",
  "rules": [
    {
      "id": "s3sqs_auth_del_denied",
      "name": "[AUTH] DeleteMessage 403 AccessDenied",
      "enabled": true,
      "mode": "all",
      "match": {
        "method": "POST",
        "body_contains": "Action=DeleteMessage"
      },
      "response": {
        "status": 403,
        "headers": {
          "Content-Type": "text/xml"
        },
        "body_type": "xml",
        "body": "<?xml version=\"1.0\"?>\n<ErrorResponse xmlns=\"http://queue.amazonaws.com/doc/2012-11-05/\"><Error><Type>Sender</Type><Code>AccessDenied</Code><Message>Access to the resource https://sqs.us-east-1.amazonaws.com/123456789012/mock-sqs-queue is denied.</Message><Detail/></Error><RequestId>{{UUID}}</RequestId></ErrorResponse>"
      }
    },
    {
      "id": "s3sqs_auth_recv_ok2",
      "name": "ReceiveMessage bình thường",
      "enabled": true,
      "mode": "all",
      "match": {
        "method": "POST",
        "body_contains": "Action=ReceiveMessage"
      },
      "response": {
        "stateful": {
          "type": "sqs_receive",
          "dataset_file": "s3_cloudtrail.json",
          "bucket": "mock-s3-bucket",
          "key_prefix": "AWSLogs/123456789012/CloudTrail/us-east-1/",
          "object_minutes": 1,
          "backlog_minutes": 10
        }
      }
    },
    {
      "id": "default_s3_get_object",
      "name": "S3 GetObject .../YYYY/MM/DD/HHMM.json -> file CloudTrail {Records:[...]} của đúng phút đó",
      "enabled": true,
      "mode": "all",
      "match": {
        "method": "GET",
        "path": "/\\d{4}/\\d{2}/\\d{2}/\\d{4}\\.json$",
        "path_match": "regex"
      },
      "response": {
        "stateful": {
          "type": "s3_object",
          "dataset_file": "s3_cloudtrail.json",
          "time_field": "eventTime",
          "object_minutes": 1
        }
      }
    }
  ]
}