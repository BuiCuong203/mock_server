{
  "name": "defender_proxy_504",
  "description": "Defender - Lỗi 504 Gateway Timeout (Lỗi Proxy)",
  "rules": [
    {
      "id": "rule_defender_alerts_proxy",
      "name": "Override: 504 Gateway Timeout",
      "enabled": true,
      "match": {
        "method": "GET",
        "path": "/api/alerts",
        "path_match": "contains"
      },
      "response": {
        "delay_ms": 15000,
        "status": 504,
        "headers": {
          "Content-Type": "text/html",
          "Server": "Squid/4.10"
        },
        "body": "<html><head><title>504 Gateway Time-out</title></head><body><center><h1>504 Gateway Time-out</h1></center><hr><center>Squid/4.10</center></body></html>"
      }
    }
  ]
}
