{
  "name": "defender_proxy_502",
  "description": "Defender - Lỗi 502 Bad Gateway (Lỗi Proxy/Nginx)",
  "rules": [
    {
      "id": "rule_defender_alerts_proxy",
      "name": "Override: 502 Bad Gateway",
      "enabled": true,
      "match": {
        "method": "GET",
        "path": "/api/alerts",
        "path_match": "contains"
      },
      "response": {
        "status": 502,
        "headers": {
          "Content-Type": "text/html",
          "Server": "nginx/1.18.0"
        },
        "body": "<html>\r\n<head><title>502 Bad Gateway</title></head>\r\n<body>\r\n<center><h1>502 Bad Gateway</h1></center>\r\n<hr><center>nginx/1.18.0</center>\r\n</body>\r\n</html>"
      }
    }
  ]
}
