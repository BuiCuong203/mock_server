{
  "name": "oauth_proxy_error_401",
  "description": "OAuth Proxy - L\u1ed7i 401 (Sai Client ID / Secret)",
  "rules": [
    {
      "id": "rule_oauth_proxy_error",
      "name": "Override: OAuth Proxy 401",
      "enabled": true,
      "match": {
        "method": "POST",
        "host": "*.microsoftonline.com",
        "path": "/oauth2/",
        "path_match": "contains"
      },
      "response": {
        "status": 401,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "error": "invalid_client",
          "error_description": "AADSTS7000215: Invalid client secret is provided."
        }
      }
    }
  ]
}