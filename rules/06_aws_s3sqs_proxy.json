[
  {
    "id": "rule_aws_sqs_receive",
    "name": "AWS SQS ReceiveMessage (Long-Polling & Notification)",
    "category": "aws_s3sqs",
    "enabled": true,
    "mode": "all",
    "match": {
      "method": "POST",
      "body_contains": "Action=ReceiveMessage"
    },
    "response": {
      "status": 200,
      "interval_sec": 10.0,
      "interval_response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/xml"
        },
        "body_type": "xml",
        "body": "<?xml version=\"1.0\"?>\n<ReceiveMessageResponse xmlns=\"http://queue.amazonaws.com/doc/2012-11-05/\">\n  <ReceiveMessageResult></ReceiveMessageResult>\n  <ResponseMetadata>\n    <RequestId>req-empty-{{TIMESTAMP}}</RequestId>\n  </ResponseMetadata>\n</ReceiveMessageResponse>"
      },
      "headers": {
        "Content-Type": "application/xml"
      },
      "body_type": "xml",
      "body": "<?xml version=\"1.0\"?>\n<ReceiveMessageResponse xmlns=\"http://queue.amazonaws.com/doc/2012-11-05/\">\n  <ReceiveMessageResult>\n    <Message>\n      <MessageId>msg-sqs-{{TIMESTAMP}}</MessageId>\n      <ReceiptHandle>mock-receipt-handle-{{TIMESTAMP}}</ReceiptHandle>\n      <MD5OfBody>e35bb0a3c2020268800b73c7f1ef2e8b</MD5OfBody>\n      <Body>{\"Records\":[{\"eventVersion\":\"2.1\",\"eventSource\":\"aws:s3\",\"awsRegion\":\"us-east-1\",\"eventTime\":\"{{NOW_ISO}}\",\"eventName\":\"ObjectCreated:Put\",\"s3\":{\"bucket\":{\"name\":\"mock-s3-bucket\",\"arn\":\"arn:aws:s3:::mock-s3-bucket\"},\"object\":{\"key\":\"logs/app_audit_2026.log\",\"size\":256}}}]}</Body>\n      <Attribute>\n        <Name>ApproximateReceiveCount</Name>\n        <Value>1</Value>\n      </Attribute>\n    </Message>\n  </ReceiveMessageResult>\n  <ResponseMetadata>\n    <RequestId>req-recv-{{TIMESTAMP}}</RequestId>\n  </ResponseMetadata>\n</ReceiveMessageResponse>"
    }
  },
  {
    "id": "rule_aws_sqs_delete",
    "name": "AWS SQS DeleteMessage",
    "category": "aws_s3sqs",
    "enabled": true,
    "mode": "all",
    "match": {
      "method": "POST",
      "body_contains": "Action=DeleteMessage"
    },
    "response": {
      "status": 200,
      "headers": {
        "Content-Type": "application/xml"
      },
      "body_type": "xml",
      "body": "<?xml version=\"1.0\"?>\n<DeleteMessageResponse xmlns=\"http://queue.amazonaws.com/doc/2012-11-05/\">\n  <ResponseMetadata>\n    <RequestId>req-del-{{TIMESTAMP}}</RequestId>\n  </ResponseMetadata>\n</DeleteMessageResponse>"
    }
  },
  {
    "id": "rule_aws_sqs_get_attributes",
    "name": "AWS SQS GetQueueAttributes",
    "category": "aws_s3sqs",
    "enabled": true,
    "mode": "all",
    "match": {
      "method": "POST",
      "body_contains": "Action=GetQueueAttributes"
    },
    "response": {
      "status": 200,
      "headers": {
        "Content-Type": "application/xml"
      },
      "body_type": "xml",
      "body": "<?xml version=\"1.0\"?>\n<GetQueueAttributesResponse xmlns=\"http://queue.amazonaws.com/doc/2012-11-05/\">\n  <GetQueueAttributesResult>\n    <Attribute>\n      <Name>ApproximateNumberOfMessages</Name>\n      <Value>1</Value>\n    </Attribute>\n    <Attribute>\n      <Name>VisibilityTimeout</Name>\n      <Value>300</Value>\n    </Attribute>\n  </GetQueueAttributesResult>\n  <ResponseMetadata>\n    <RequestId>req-attrs-{{TIMESTAMP}}</RequestId>\n  </ResponseMetadata>\n</GetQueueAttributesResponse>"
    }
  },
  {
    "id": "rule_aws_s3_get_object",
    "name": "AWS S3 GetObject (Download Log Content)",
    "category": "aws_s3sqs",
    "enabled": true,
    "mode": "all",
    "match": {
      "method": "GET",
      "path_match": "regex",
      "path": "(\\.log|\\.json|\\.gz|\\.txt|mock-s3-bucket|logs/)"
    },
    "response": {
      "status": 200,
      "headers": {
        "Content-Type": "text/plain; charset=utf-8"
      },
      "body_type": "text",
      "body": "{\"eventVersion\":\"1.08\",\"userIdentity\":{\"type\":\"IAMUser\",\"userName\":\"alice\"},\"eventTime\":\"{{NOW_ISO}}\",\"eventSource\":\"s3.amazonaws.com\",\"eventName\":\"GetObject\",\"awsRegion\":\"us-east-1\"}\n"
    }
  },
  {
    "id": "rule_aws_s3_head_object",
    "name": "AWS S3 HeadObject (Metadata Check)",
    "category": "aws_s3sqs",
    "enabled": true,
    "mode": "all",
    "match": {
      "method": "HEAD"
    },
    "response": {
      "status": 200,
      "headers": {
        "Content-Type": "text/plain; charset=utf-8",
        "Content-Length": "165",
        "ETag": "\"mock-etag-123456789\""
      }
    }
  },
  {
    "id": "rule_aws_sqs_change_visibility",
    "name": "AWS SQS ChangeMessageVisibility",
    "enabled": true,
    "match": {
      "method": "POST",
      "body_contains": "Action=ChangeMessageVisibility"
    },
    "response": {
      "status": 200,
      "headers": {
        "Content-Type": "text/xml"
      },
      "body": "<ChangeMessageVisibilityResponse><ResponseMetadata><RequestId>req-vis-{{TIMESTAMP}}</RequestId></ResponseMetadata></ChangeMessageVisibilityResponse>"
    }
  }
]